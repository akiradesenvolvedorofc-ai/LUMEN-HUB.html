# Copie este arquivo para ".env" e preencha
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=troque-por-uma-frase-longa-e-aleatoria

# Discord Developer Portal > Applications > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# ID do seu servidor (Modo desenvolvedor > botão direito no servidor > Copiar ID)
DISCORD_GUILD_ID=
# IDs dos cargos que podem entrar no painel (Dono e staff), separados por vírgula
ADMIN_ROLE_IDS=

# Webhook do canal de suporte/pedidos (Editar canal > Integrações > Webhooks)
DISCORD_WEBHOOK_URL=
# (opcional) ID de um cargo para ser mencionado em novos tickets/pedidos
SUPPORT_ROLE_ID=
# (opcional) senha extra pedida ao admin depois do login com Discord
ADMIN_PASSWORD=
